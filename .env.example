# VANGUARD Environment Configuration

# Google Gemini API Key (Required for AI Situation Briefings & COA generation)
# Obtain your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Server & WebSocket Configuration
PORT=3001
HOST=localhost

# Client Port (Vite)
VITE_PORT=5173
VITE_BACKEND_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001/stream

# Feature Flags
VITE_ENABLE_AUDIO_BRIEFING=true
VITE_ENABLE_SIMULATION_FALLBACK=true
