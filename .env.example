# VANGUARD Environment Configuration
#
# EVERY VARIABLE BELOW IS OPTIONAL.
# The server boots and serves a complete operational picture with an entirely
# empty environment — no API key, no database, no Docker.
#
#   cd server && npm install && npm run dev
#
# Copy this file to .env only if you want to override a default.

# ─── AI synthesis ────────────────────────────────────────────────────────────
# Optional. Without a key, briefings are produced by the DETERMINISTIC engine:
# a complete, correctly cited AISummary with no model call at all.
# Get a key at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
# Comma-separated origins, or * for any.
CORS_ORIGINS=*

# ─── Pipeline cadence ────────────────────────────────────────────────────────
# Master tick: ingest -> normalize -> validate -> store -> fuse -> broadcast.
TICK_INTERVAL_MS=3000
# Live Open-Meteo poll. Weather changes slowly; polling faster wastes the API.
WEATHER_POLL_INTERVAL_MS=120000
# Background briefing regeneration. The cached briefing is always served
# instantly, so no operator ever waits on an inference call.
BRIEFING_INTERVAL_MS=45000

# ─── Simulation ──────────────────────────────────────────────────────────────
# Seeds every simulator. The SAME SEED PRODUCES THE SAME SCENARIO on every
# machine — a demo you cannot rehearse is a demo you cannot trust.
SIM_SEED=20260908
# Multiplier on simulated event volume. 1 gives ~45 concurrent events, which is
# what the threat thresholds are calibrated against.
SIM_INTENSITY=1

# ─── Diagnostics ─────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
# Gates POST /api/v1/simulation/* — scenario injection, degraded comms, what-if
# sandbox and reset. Set false to serve a read-only operational picture.
ENABLE_SIMULATION_API=true

# ─── Frontend (Phase 2, not yet implemented) ─────────────────────────────────
VITE_PORT=5173
VITE_BACKEND_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001/stream
VITE_ENABLE_AUDIO_BRIEFING=true
VITE_ENABLE_SIMULATION_FALLBACK=true
